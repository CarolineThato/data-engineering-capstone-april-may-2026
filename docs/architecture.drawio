<mxfile host="app.diagrams.net"><diagram id="arch1" name="Customer360 architecture"><mxGraphModel dx="1400" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1540" pageHeight="700" math="0" shadow="0" background="#FFFFFF"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="a2" value="1. Source file" style="swimlane;fontStyle=1;fontSize=13;startSize=34;horizontal=1;collapsible=0;resizable=0;fillColor=#1FBA9D;strokeColor=#13806C;fontColor=#FFFFFF;swimlaneFillColor=#FFFFFF;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="40" y="40" width="300" height="164" as="geometry"/></mxCell><mxCell id="a3" value="&lt;b&gt;activity_extract.csv&lt;/b&gt;&lt;br&gt;21,500 rows, 23 columns&lt;br&gt;2,000 product enrollments&lt;br&gt;4,500 CRM interactions&lt;br&gt;15,000 transactions" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;fontColor=#333333;spacingLeft=10;spacingTop=6;" vertex="1" parent="a2"><mxGeometry x="0" y="34" width="300" height="130" as="geometry"/></mxCell><mxCell id="a4" value="2. SSIS package 1" style="swimlane;fontStyle=1;fontSize=13;startSize=34;horizontal=1;collapsible=0;resizable=0;fillColor=#1FBA9D;strokeColor=#13806C;fontColor=#FFFFFF;swimlaneFillColor=#FFFFFF;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="400" y="40" width="300" height="164" as="geometry"/></mxCell><mxCell id="a5" value="&lt;b&gt;Load_Customer_Activity.dtsx&lt;/b&gt;&lt;br&gt;Step 1: truncate the raw table&lt;br&gt;Step 2: Flat File Source to&lt;br&gt;OLE DB Destination&lt;br&gt;Code page 1252, all columns text" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;fontColor=#333333;spacingLeft=10;spacingTop=6;" vertex="1" parent="a4"><mxGeometry x="0" y="34" width="300" height="130" as="geometry"/></mxCell><mxCell id="a6" value="3. Raw layer" style="swimlane;fontStyle=1;fontSize=13;startSize=34;horizontal=1;collapsible=0;resizable=0;fillColor=#1FBA9D;strokeColor=#13806C;fontColor=#FFFFFF;swimlaneFillColor=#FFFFFF;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="760" y="51" width="300" height="142" as="geometry"/></mxCell><mxCell id="a7" value="&lt;b&gt;source.customer_activity_extract&lt;/b&gt;&lt;br&gt;21,500 rows, all VARCHAR&lt;br&gt;No cleaning at this stage&lt;br&gt;Safe to reload (truncate first)" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;fontColor=#333333;spacingLeft=10;spacingTop=6;" vertex="1" parent="a6"><mxGeometry x="0" y="34" width="300" height="108" as="geometry"/></mxCell><mxCell id="a8" value="4. SSIS package 2" style="swimlane;fontStyle=1;fontSize=13;startSize=34;horizontal=1;collapsible=0;resizable=0;fillColor=#1FBA9D;strokeColor=#13806C;fontColor=#FFFFFF;swimlaneFillColor=#FFFFFF;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="1120" y="40" width="300" height="164" as="geometry"/></mxCell><mxCell id="a9" value="&lt;b&gt;02_Build_DW.dtsx&lt;/b&gt;&lt;br&gt;Three Execute SQL Tasks, in order:&lt;br&gt;EXEC stg.load_staging&lt;br&gt;EXEC dw.load_dimensions&lt;br&gt;EXEC dw.load_facts" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;fontColor=#333333;spacingLeft=10;spacingTop=6;" vertex="1" parent="a8"><mxGeometry x="0" y="34" width="300" height="130" as="geometry"/></mxCell><mxCell id="a10" value="5. Staging (stg)" style="swimlane;fontStyle=1;fontSize=13;startSize=34;horizontal=1;collapsible=0;resizable=0;fillColor=#1FBA9D;strokeColor=#13806C;fontColor=#FFFFFF;swimlaneFillColor=#FFFFFF;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="40" y="380" width="340" height="208" as="geometry"/></mxCell><mxCell id="a11" value="&lt;b&gt;Cleans and splits the raw rows&lt;/b&gt;&lt;br&gt;stg.client: 1,484 rows&lt;br&gt;stg.enrollment: 2,000 rows&lt;br&gt;stg.interaction: 4,499 rows&lt;br&gt;stg.txn: 15,000 rows&lt;br&gt;Trims text, fixes phone numbers,&lt;br&gt;removes the one duplicate row" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;fontColor=#333333;spacingLeft=10;spacingTop=6;" vertex="1" parent="a10"><mxGeometry x="0" y="34" width="340" height="174" as="geometry"/></mxCell><mxCell id="a12" value="6. Warehouse (dw)" style="swimlane;fontStyle=1;fontSize=13;startSize=34;horizontal=1;collapsible=0;resizable=0;fillColor=#1FBA9D;strokeColor=#13806C;fontColor=#FFFFFF;swimlaneFillColor=#FFFFFF;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="440" y="380" width="560" height="208" as="geometry"/></mxCell><mxCell id="a13" value="&lt;b&gt;Dimensions (7)&lt;/b&gt;&lt;br&gt;dim_client, dim_date, dim_product, dim_account,&lt;br&gt;dim_channel, dim_interaction_type, dim_transaction_type&lt;br&gt;&lt;b&gt;Facts (3)&lt;/b&gt;&lt;br&gt;fact_transaction: 15,000 rows (1 per transaction)&lt;br&gt;fact_interaction: 4,499 rows (1 per CRM interaction)&lt;br&gt;fact_account: 2,000 rows (1 per account)" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;fontColor=#333333;spacingLeft=10;spacingTop=6;" vertex="1" parent="a12"><mxGeometry x="0" y="34" width="560" height="174" as="geometry"/></mxCell><mxCell id="a14" value="7. Business analysis" style="swimlane;fontStyle=1;fontSize=13;startSize=34;horizontal=1;collapsible=0;resizable=0;fillColor=#1FBA9D;strokeColor=#13806C;fontColor=#FFFFFF;swimlaneFillColor=#FFFFFF;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="1060" y="402" width="320" height="164" as="geometry"/></mxCell><mxCell id="a15" value="&lt;b&gt;20 business questions&lt;/b&gt;&lt;br&gt;sql/03_answers.sql&lt;br&gt;Queries run on the warehouse only&lt;br&gt;Customers, products, transactions,&lt;br&gt;CRM, segments, retention" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;fontColor=#333333;spacingLeft=10;spacingTop=6;" vertex="1" parent="a14"><mxGeometry x="0" y="34" width="320" height="130" as="geometry"/></mxCell><mxCell id="a16" value="" style="edgeStyle=none;rounded=0;html=1;endArrow=block;endFill=1;stro